# Wallet
PRIVATE_KEY=

# Connection  
RPC_ENDPOINT=https://api.mainnet-beta.solana.com
RPC_WEBSOCKET_ENDPOINT=wss://api.mainnet-beta.solana.com
COMMITMENT_LEVEL=confirmed

# Geyser / Yellowstone Dragon's Mouth (recommended for fastest detection)
# Providers: Triton (triton.one), Helius, QuickNode
USE_GEYSER=true
GEYSER_ENDPOINT=

# Bot
LOG_LEVEL=info
ONE_TOKEN_AT_A_TIME=true
PRE_LOAD_EXISTING_MARKETS=false
CACHE_NEW_MARKETS=false

# Transaction Executor (jito = fastest + bundle propagation)
TRANSACTION_EXECUTOR=jito
CUSTOM_FEE=0.01

# Buy - 1 SOL per trade
QUOTE_MINT=WSOL
QUOTE_AMOUNT=1
AUTO_BUY_DELAY=0
MAX_BUY_RETRIES=5
BUY_SLIPPAGE=5

# Sell
AUTO_SELL=true
REBUY_SAME_TOKEN=false
MAX_SELL_RETRIES=3
AUTO_SELL_DELAY=0
PRICE_CHECK_INTERVAL=1000
PRICE_CHECK_DURATION=300000
TAKE_PROFIT=100
STOP_LOSS=50
SELL_SLIPPAGE=10

# Trailing Stop Loss (optional)
USE_TRAILING_STOP=false
TRAILING_STOP_DISTANCE=10
TRAILING_STOP_ACTIVATION=50

# DEX Mode: raydium, pumpswap, pump, all
DEX=pump

# PumpFun Slippage
PUMP_BUY_SLIPPAGE=1
PUMP_SELL_SLIPPAGE=1

# Filters
USE_SNIPE_LIST=false
SNIPE_LIST_REFRESH_INTERVAL=30000
FILTER_CHECK_DURATION=30000
FILTER_CHECK_INTERVAL=1000
CONSECUTIVE_FILTER_MATCHES=2
CHECK_IF_MUTABLE=false
CHECK_IF_SOCIALS=true
CHECK_IF_MINT_IS_RENOUNCED=true
CHECK_IF_FREEZABLE=false
CHECK_IF_BURNED=true
MIN_POOL_SIZE=10
MAX_POOL_SIZE=500
