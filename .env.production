# Wallet
PRIVATE_KEY=

# Connection
RPC_ENDPOINT=http://
RPC_WEBSOCKET_ENDPOINT=ws://
COMMITMENT_LEVEL=confirmed

# Geyser / Yellowstone Dragon's Mouth
USE_GEYSER=true
GEYSER_ENDPOINT=

# Bot
LOG_LEVEL=info
DRY_RUN=false
ONE_TOKEN_AT_A_TIME=true
PRE_LOAD_EXISTING_MARKETS=true
CACHE_NEW_MARKETS=true
# default or warp or jito
TRANSACTION_EXECUTOR=default
# if using default executor, fee below will be applied
COMPUTE_UNIT_LIMIT=101337
COMPUTE_UNIT_PRICE=1000000
# if using warp or jito executor, fee below will be applied
CUSTOM_FEE=0.006

# Buy
QUOTE_MINT=WSOL
QUOTE_AMOUNT=1
AUTO_BUY_DELAY=0
MAX_BUY_RETRIES=3
BUY_SLIPPAGE=20

# Sell
AUTO_SELL=true
MAX_SELL_RETRIES=10
AUTO_SELL_DELAY=0
PRICE_CHECK_INTERVAL=2000
PRICE_CHECK_DURATION=60000
TAKE_PROFIT=50
STOP_LOSS=30
SELL_SLIPPAGE=20

# Filters
USE_SNIPE_LIST=false
SNIPE_LIST_REFRESH_INTERVAL=30000
FILTER_CHECK_DURATION=60000
FILTER_CHECK_INTERVAL=2000
CONSECUTIVE_FILTER_MATCHES=1
CHECK_IF_MUTABLE=true
CHECK_IF_SOCIALS=true
CHECK_IF_MINT_IS_RENOUNCED=true
CHECK_IF_FREEZABLE=false
CHECK_IF_BURNED=true
MIN_POOL_SIZE=10
MAX_POOL_SIZE=500
